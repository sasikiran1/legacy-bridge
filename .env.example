# Copy to .env (gitignored) and fill in. Nothing here may require a credit card.

# LLM mode: replay (cassettes, default and the only mode CI uses), record, or live
LLM_MODE=replay

# Hosted free tiers. Only tokenized text reaches these providers (docs/threat-model.md).
GROQ_API_KEY=
GEMINI_API_KEY=

# Local models. LOCAL_TEXT_MODEL is the Ollama model the `local_text` role routes to (pull it first).
OLLAMA_BASE_URL=http://localhost:11434/v1
LOCAL_TEXT_MODEL=

# Agent: `local` sends every node to LOCAL_TEXT_MODEL; `hosted` uses the plan/api_tier/explore chains.
AGENT_PROFILE=local
# Injection classifier: none | promptguard (needs gated access to Prompt Guard 2 and HF_TOKEN; ADR 0009)
INJECTION_SCANNER=none
# Send agent traces to Phoenix (started by compose) by setting this to http://phoenix:6006
AGENT_OTLP_ENDPOINT=

# Hugging Face Hub, needed only for gated models (Prompt Guard 2, ADR 0009)
HF_TOKEN=

# Vault: 32-byte key, base64. Generate with:
#   uv run python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
VAULT_MASTER_KEY=
VAULT_TASK_TTL_SECONDS=3600

# Token derivation (ADR 0001): 32-byte key, base64, separate from the vault key.
# This published value is what cassette recording and CI use, so replay is deterministic.
# That is acceptable only because all PII here is synthetic; with real data the key must be secret.
TOKEN_KEY=bGVnYWN5LWJyaWRnZSBzeW50aGV0aWMgdG9rZW4gazE=
RUN_SEED=7

# PII proxy: detector configuration (regex | presidio | presidio_gliner | full) and audit log location
PII_DETECTOR=full
AUDIT_LOG_PATH=.cache/audit/proxy.jsonl

# Infrastructure
POSTGRES_USER=legacy
POSTGRES_PASSWORD=change-me
PORTAL_DB_URL=postgresql://legacy:change-me@localhost:5432/portal
AGENT_DB_URL=postgresql://legacy:change-me@localhost:5432/agent
REDIS_URL=redis://localhost:6379/0

# Portal
PORTAL_BASE_URL=http://localhost:8080
PORTAL_ADMIN_TOKEN=change-me
# Password assigned to every seeded portal user (clerk01-04, supervisor01) at startup and after reset.
# Credentials never enter a prompt (docs/threat-model.md T6).
PORTAL_TEST_USER_PASSWORD=change-me

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
